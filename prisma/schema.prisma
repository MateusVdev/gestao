generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
  ALERT
}

enum FinancialKind {
  INCOME
  EXPENSE
}

enum NotificationType {
  INFO
  WARNING
  DANGER
  SUCCESS
}

enum StockMovementKind {
  IN
  OUT
  ADJUSTMENT
}

enum ServiceMotorcycleStatus {
  GARAGE
  IN_SERVICE
  MAINTENANCE
  UNAVAILABLE
}

enum MaintenanceStatus {
  ONGOING
  WAITING_PARTS
  CONCLUDED
  CANCELED
}

enum MotorcycleFineStatus {
  PENDING
  PARTIAL
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id            String           @id @default(cuid())
  name          String
  model         String
  plate         String           @unique
  year          Int
  driver        String
  entryDate     DateTime
  exitDate      DateTime?
  status        VehicleStatus    @default(ACTIVE)
  mileage       Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  maintenances  Maintenance[]
  oilChanges    OilChange[]
  fuelLogs      FuelLog[]
  finances      FinancialEntry[]
  notifications Notification[]
  attachments   Attachment[]
}

model Maintenance {
  id             String            @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date           DateTime
  type           String
  mechanic       String
  notes          String?
  totalValue     Decimal           @db.Decimal(12, 2)
  status         MaintenanceStatus @default(ONGOING)
  concludedAt    DateTime?
  concludedBy    String?
  createdAt      DateTime          @default(now())
  parts          MaintenancePart[]
  stockMovements StockMovement[]
  attachments    Attachment[]

  @@index([vehicleId])
  @@index([date])
}

model MaintenancePart {
  id            String      @id @default(cuid())
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  partStockId   String?
  partStock     PartStock?  @relation(fields: [partStockId], references: [id], onDelete: SetNull)
  name          String
  quantity      Int
  unitValue     Decimal     @db.Decimal(12, 2)
  totalValue    Decimal     @db.Decimal(12, 2)

  @@index([maintenanceId])
  @@index([partStockId])
}

model OilChange {
  id            String       @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  oilType       String
  liters        Decimal      @db.Decimal(10, 2)
  valuePerLiter Decimal      @db.Decimal(12, 2)
  totalValue    Decimal      @db.Decimal(12, 2)
  date          DateTime
  createdAt     DateTime     @default(now())
  attachments   Attachment[]

  @@index([vehicleId])
  @@index([date])
}

model FinancialEntry {
  id                  String             @id @default(cuid())
  kind                FinancialKind
  category            String
  description         String
  value               Decimal            @db.Decimal(12, 2)
  date                DateTime
  vehicleId           String?
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceMotorcycleId String?
  serviceMotorcycle   ServiceMotorcycle? @relation(fields: [serviceMotorcycleId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([vehicleId])
  @@index([serviceMotorcycleId])
  @@index([date])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contact        String
  email          String
  phone          String
  document       String?
  createdAt      DateTime        @default(now())
  parts          PartStock[]
  stockMovements StockMovement[]
  attachments    Attachment[]
}

model PartStock {
  id               String            @id @default(cuid())
  name             String
  category         String            @default("Geral")
  sku              String            @unique
  manufacturer     String            @default("Nao informado")
  quantity         Int
  minQuantity      Int
  unitCost         Decimal           @db.Decimal(12, 2)
  entryDate        DateTime          @default(now())
  notes            String?
  supplierId       String?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  deletedBy        String?
  maintenanceParts MaintenancePart[]
  stockMovements   StockMovement[]
  attachments      Attachment[]
}

model StockMovement {
  id              String            @id @default(cuid())
  partStockId     String
  partStock       PartStock         @relation(fields: [partStockId], references: [id], onDelete: Cascade)
  kind            StockMovementKind
  quantity        Int
  unitCost        Decimal           @db.Decimal(12, 2)
  totalValue      Decimal           @db.Decimal(12, 2)
  date            DateTime
  purchaseDate    DateTime?
  supplierId      String?
  supplier        Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNumber   String?
  responsibleUser String
  maintenanceId   String?
  maintenance     Maintenance?      @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  notes           String?
  createdAt       DateTime          @default(now())

  @@index([partStockId])
  @@index([date])
  @@index([maintenanceId])
}

model FuelLog {
  id            String       @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fuelType      String
  liters        Decimal      @db.Decimal(10, 2)
  pricePerLiter Decimal      @db.Decimal(12, 2)
  totalValue    Decimal      @db.Decimal(12, 2)
  station       String
  date          DateTime
  createdAt     DateTime     @default(now())
  attachments   Attachment[]

  @@index([vehicleId])
  @@index([date])
}

enum NotificationStatus {
  UNREAD
  READ
  RESOLVED
}

enum NotificationPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Notification {
  id        String               @id @default(cuid())
  title     String
  message   String
  type      NotificationType     @default(INFO)
  priority  NotificationPriority @default(MEDIUM)
  status    NotificationStatus   @default(UNREAD)
  link      String?
  category  String?
  entityId  String?
  dueDate   DateTime?
  vehicleId String?
  vehicle   Vehicle?             @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([priority])
  @@index([entityId])
}

model ServiceMotorcycle {
  id          String                  @id @default(cuid())
  model       String
  brand       String
  plate       String                  @unique
  year        Int
  mileage     Int
  status      ServiceMotorcycleStatus @default(GARAGE)
  driver      String
  photoUrl    String?
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  trips       MotorcycleTrip[]
  fines       MotorcycleFine[]
  finances    FinancialEntry[]
  attachments Attachment[]
}

model MotorcycleTrip {
  id                  String            @id @default(cuid())
  serviceMotorcycleId String
  serviceMotorcycle   ServiceMotorcycle @relation(fields: [serviceMotorcycleId], references: [id], onDelete: Cascade)
  departureAt         DateTime
  returnAt            DateTime?
  driver              String
  destination         String
  serviceDone         String
  quantityTransported Int
  notes               String?
  createdAt           DateTime          @default(now())
  fine                MotorcycleFine?

  @@index([serviceMotorcycleId])
  @@index([departureAt])
}

model MotorcycleFine {
  id                  String               @id @default(cuid())
  serviceMotorcycleId String
  serviceMotorcycle   ServiceMotorcycle    @relation(fields: [serviceMotorcycleId], references: [id], onDelete: Cascade)
  tripId              String?              @unique
  trip                MotorcycleTrip?      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  value               Decimal              @db.Decimal(12, 2)
  paidAmount          Decimal              @default(0) @db.Decimal(12, 2)
  paymentStatus       MotorcycleFineStatus @default(PENDING)
  paidBy              String?
  authorizedBy        String?
  paidAt              DateTime?
  paymentNotes        String?
  paymentHistory      Json?
  reason              String
  date                DateTime
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  attachments         Attachment[]
}

model ActivityLog {
  id          String   @id @default(cuid())
  userName    String
  action      String
  entity      String
  entityId    String?
  description String
  createdAt   DateTime @default(now())
  module      String?
  date        String?
  time        String?
  ipAddress   String?
  device      String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?

  @@index([createdAt])
  @@index([entityId])
}

model AuditTrail {
  id        String   @id @default(cuid())
  userName  String
  module    String
  entityId  String?
  summary   String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())
}
model Attachment {
  id                  String             @id @default(cuid())
  publicId            String?
  ownerType           String
  ownerId             String
  ownerLabel          String
  fileName            String
  fileType            String
  fileSize            Int
  url                 String
  uploadedBy          String
  description         String?
  module              String             @default("Geral")
  vehicleId           String?
  vehicle             Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  maintenanceId       String?
  maintenance         Maintenance?       @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  oilChangeId         String?
  oilChange           OilChange?         @relation(fields: [oilChangeId], references: [id], onDelete: SetNull)
  fuelLogId           String?
  fuelLog             FuelLog?           @relation(fields: [fuelLogId], references: [id], onDelete: SetNull)
  supplierId          String?
  supplier            Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  partStockId         String?
  partStock           PartStock?         @relation(fields: [partStockId], references: [id], onDelete: SetNull)
  serviceMotorcycleId String?
  serviceMotorcycle   ServiceMotorcycle? @relation(fields: [serviceMotorcycleId], references: [id], onDelete: SetNull)
  motorcycleFineId    String?
  motorcycleFine      MotorcycleFine?    @relation(fields: [motorcycleFineId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())
}

model DeletedItem {
  id                   String    @id @default(cuid())
  entity               String
  entityId             String
  label                String
  payload              Json
  deletedBy            String
  deletedAt            DateTime  @default(now())
  restoredAt           DateTime?
  permanentlyDeletedAt DateTime?
}

model BackupRecord {
  id        String   @id @default(cuid())
  type      String
  status    String
  fileName  String
  size      Int
  source    String
  createdBy String
  createdAt DateTime @default(now())
  message   String?
}

model AppSetting {
  id                    String   @id @default("default")
  cooperativeName       String   @default("CoopFleet")
  logoUrl               String?
  theme                 String   @default("premium-dark")
  currency              String   @default("BRL")
  timezone              String   @default("America/Sao_Paulo")
  backupFrequency       String   @default("daily")
  backupRetentionDays   Int      @default(30)
  notificationsEnabled  Boolean  @default(true)
  sessionTimeoutMinutes Int      @default(480)
  updatedAt             DateTime @updatedAt
}
